# Virtual environment
.venv/
venv/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Environment variables & secrets
.env
.env.local

# OS generated files
.DS_Store
Thumbs.db

# Data directories (ignore data files but preserve directory structure and .gitkeep)
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep

data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep

data/splits/**
!data/splits/**/
!data/splits/**/.gitkeep

# Model weights
weights/*.pt
weights/**
!weights/**/
!weights/**/.gitkeep

# Outputs
outputs/**
!outputs/**/
!outputs/**/.gitkeep

# Catch-all rule for .gitkeep
!.gitkeep
!**/.gitkeep
